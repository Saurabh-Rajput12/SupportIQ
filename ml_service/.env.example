ML_HOST=127.0.0.1
ML_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# GenAI & RAG configuration
REPLY_PROVIDER=hf_local            # hf_local | openai_compatible | demo_fallback
REPLY_MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
REPLY_API_KEY=                     # only for API providers
REPLY_API_BASE=                    # e.g. http://localhost:11434/v1
EMBED_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=3
RAG_MIN_SCORE=0.35
ENABLE_JUDGE=true
GEN_MAX_NEW_TOKENS=220
